{
  "$schema": "https://frictionlessdata.io/schemas/table-schema.json",
  "name": "notfall-lagebild",
  "title": "Notfall-Lagebild",
  "description": "Standortdaten kommunaler Notfall-Infrastruktur für ein operatives Lagebild.",
  "fields": [
    {
      "name": "id",
      "title": "Eindeutige Kennung",
      "type": "string",
      "constraints": {
        "required": true
      },
      "description": "Eindeutige Kennung des Standorts."
    },
    {
      "name": "name",
      "title": "Anzeigename",
      "type": "string",
      "constraints": {
        "required": true
      },
      "description": "Name des Standorts."
    },
    {
      "name": "typ",
      "title": "Hauptkategorie",
      "type": "string",
      "constraints": {
        "required": true
      },
      "description": "Art des Standorts, z. B. Notunterkunft."
    },
    {
      "name": "untertyp",
      "title": "Feinerer Typ",
      "type": "string",
      "description": "Unterart des Standorts."
    },
    {
      "name": "status",
      "title": "Betriebszustand",
      "type": "string",
      "constraints": {
        "enum": [
          "aktiv",
          "eingeschränkt",
          "außer Betrieb",
          "geplant"
        ]
      },
      "description": "Betriebsstatus, z. B. aktiv."
    },
    {
      "name": "kapazitaet_max",
      "title": "Gesamtkapazität",
      "type": "integer",
      "description": "Maximale Kapazität (Plätze)."
    },
    {
      "name": "kapazitaet_verfuegbar",
      "title": "Freie Kapazität",
      "type": "integer",
      "description": "Aktuell verfügbare Kapazität (Plätze)."
    },
    {
      "name": "auslastung_prozent",
      "title": "Auslastung in Prozent",
      "type": "integer",
      "description": "Auslastung in Prozent."
    },
    {
      "name": "strasse",
      "title": "Straße und Hausnummer",
      "type": "string",
      "description": "Straße und Hausnummer."
    },
    {
      "name": "plz",
      "title": "Postleitzahl",
      "type": "string",
      "description": "Postleitzahl als Text."
    },
    {
      "name": "ort",
      "title": "Ort",
      "type": "string",
      "description": "Ort."
    },
    {
      "name": "stadtteil",
      "title": "Stadtteil oder Bezirk",
      "type": "string",
      "description": "Stadtteil."
    },
    {
      "name": "lat",
      "title": "Breitengrad",
      "type": "number",
      "description": "Breitengrad (WGS84)."
    },
    {
      "name": "lon",
      "title": "Längengrad",
      "type": "number",
      "description": "Längengrad (WGS84)."
    },
    {
      "name": "barrierefrei",
      "title": "Barrierefrei",
      "type": "string",
      "description": "Barrierefreiheit als „ja“/„nein“-Text (kein JSON-Boolean)."
    },
    {
      "name": "stromversorgung_notstrom",
      "title": "Notstrom vorhanden",
      "type": "string",
      "description": "Notstromversorgung als „ja“/„nein“-Text."
    },
    {
      "name": "wasser_verfuegbar",
      "title": "Wasser verfügbar",
      "type": "string",
      "description": "Trinkwasserversorgung als „ja“/„nein“-Text."
    },
    {
      "name": "sanitaer_verfuegbar",
      "title": "Sanitär verfügbar",
      "type": "string",
      "description": "Sanitärversorgung als „ja“/„nein“-Text."
    },
    {
      "name": "betreiber",
      "title": "Betreiber oder Zuständigkeit",
      "type": "string",
      "description": "Betreiber des Standorts."
    },
    {
      "name": "ansprechpartner",
      "title": "Ansprechstelle",
      "type": "string",
      "description": "Ansprechpartner vor Ort."
    },
    {
      "name": "letzte_pruefung",
      "title": "Letzte Prüfung",
      "type": "date",
      "format": "default",
      "description": "Datum der letzten Prüfung (JJJJ-MM-TT)."
    },
    {
      "name": "prioritaet",
      "title": "Priorität",
      "type": "string",
      "constraints": {
        "enum": [
          "hoch",
          "mittel",
          "niedrig"
        ]
      },
      "description": "Priorität, z. B. hoch."
    },
    {
      "name": "hinweis",
      "title": "Hinweis",
      "type": "string",
      "description": "Freier Hinweis zum Standort."
    }
  ],
  "primaryKey": "id",
  "missingValues": [
    ""
  ]
}
